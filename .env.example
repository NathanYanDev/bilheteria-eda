# Copie para .env e preencha. O .env NUNCA deve ser commitado.

# URL do broker no CloudAMQP (painel da instância -> "AMQP URL", começa com amqps://)
AMQP_URL=

# Atraso artificial (segundos) em cada pagamento, para a divisão de carga entre réplicas ficar visível
PAYMENT_DELAY=2

# Banco SQLite compartilhado entre a API e os workers
DB_PATH=data/bilheteria.db
